# Security & Monetization Configuration (.env)
# Copy this file to .env and fill in your details (do not commit .env to public GitHub)

# Ads
ENABLE_ADS=true

# Affiliates (Insert your tracking IDs)
AFFILIATE_PORKBUN=https://porkbun.com/checkout/search?q={domain}&affid=YOUR_ID
AFFILIATE_NAMECHEAP=https://www.namecheap.com/domains/registration/results/?domain={domain}&aff=YOUR_ID
AFFILIATE_GODADDY=https://www.godaddy.com/domainsearch/find?checkAvail=1&domainToCheck={domain}
AFFILIATE_HOSTINGER=https://www.hostinger.com/web-hosting?domain={domain}&ref=YOUR_ID
AFFILIATE_SHOPIFY=https://www.shopify.com/free-trial?domain={domain}&ref=YOUR_ID

# Donations
BUY_ME_A_COFFEE_URL=https://buymeacoffee.com/yourusername

# Private SMTP for Domain Drop Alerts (Optional)
SMTP_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=your-email@gmail.com
SMTP_SENDER_PASSWORD=your-google-app-password
SMTP_FROM_NAME=Domain Drop Watcher Alert

# Rate Limits / Abuse Protection
MAX_BULK_SCAN_DOMAINS=500
